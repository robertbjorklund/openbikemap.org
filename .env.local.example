# Local tileserver (run tiles.openbikemap.org/scripts/dev-tiles.ps1 first)
VITE_TILES_BASE_URL=http://localhost:8083

# Optional: override style path (tileserver-gl default shown)
# VITE_TILES_STYLE_PATH=/styles/terrain/style.json

# Local API (when api.openbikemap.org/docker is running)
VITE_API_BASE_URL=http://localhost:3002

# Cloudflare Web Analytics (optional — beacon token from Cloudflare dashboard)
# VITE_CF_BEACON_TOKEN=your-beacon-token

# Self-hosted Matomo (optional — leave unset to disable analytics in dev)
# VITE_MATOMO_URL=https://analytics.openbikemap.org
# VITE_MATOMO_SITE_ID=1

# Preview beta banner + feedback (default on; set false to hide locally)
# VITE_BETA_BANNER=false
